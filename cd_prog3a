#include <iostream>
#include <string>
using namespace std;
string input;
int i = 0;
bool A() {
int back = i;
// Try A → ab
if (input[i] == 'a') {
i++;
if (input[i] == 'b') {
i++;
return true;
}
}
// Backtrack
i = back;
// Try A → a
if (input[i] == 'a') {
i++;
return true;
}
return false;
}
bool S() {
if (input[i] == 'c') {
i++;
if (A()) {
if (input[i] == 'd') {
i++;
return true;
}
}
}
return false;
}
int main() {
cout << "Enter input string: ";
cin >> input;
i = 0;
if (S() && i == input.length()) {
cout << "String accepted (Grammar A: A → ab | a)\n";
} else {
cout << "String rejected (Grammar A: A → ab | a)\n";
}
return 0;
}